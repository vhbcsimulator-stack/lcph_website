# Copy to .env and fill in. Every VITE_ variable is inlined into the public client
# bundle — never put a private API key or token here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GoHighLevel Inbound Webhook URL — every public form (contact, site visit, partner
# accreditation) posts here. Create it in GHL: Automation > Workflows > new workflow
# with the "Inbound Webhook" trigger, then copy the generated URL.
# Safe to expose: it accepts writes only and returns no data.
VITE_GHL_WEBHOOK_URL=
